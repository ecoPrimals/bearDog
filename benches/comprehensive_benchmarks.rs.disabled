//! Comprehensive benchmarks for BearDog performance validation
//! Tests all major performance-critical components

use beardog_core::BearDogCore;
use beardog_errors::BearDogError;
use beardog_security::SecurityProvider;
use beardog_utils::optimization::OptimizationEngine;
use criterion::{black_box, criterion_group, criterion_main, Criterion};
use std::time::Duration;
use tokio::runtime::Runtime;

/// Initialize benchmark runtime with proper error handling
fn init_benchmark_runtime() -> Result<Runtime, BearDogError> {
    Runtime::new().map_err(|e| {
        eprintln!("Benchmark runtime creation failed: {:?}", e);
        beardog_errors::BearDogError::system(format!("Runtime creation failed: {:?}", e))
    })
}

fn benchmark_core_operations(c: &mut Criterion) {
    let rt = init_benchmark_runtime().expect("Failed to create runtime");

    c.bench_function("core_initialization", |b| {
        b.iter(|| {
            // BearDogCore::new() is synchronous, not async
            let config = beardog_types::canonical::config::unified::UnifiedBearDogConfig::default();
            let core = BearDogCore::new(config);
            black_box(core);
        });
    });
}

fn benchmark_security_operations(c: &mut Criterion) {
    let rt = init_benchmark_runtime().expect("Failed to create runtime");

    c.bench_function("security_provider_init", |b| {
        b.iter(|| {
            // Simplified security provider initialization for benchmarking
            let config = beardog_types::canonical::CanonicalSecurityConfig::default();
            black_box(config);
        });
    });
}

fn benchmark_optimization_engine(c: &mut Criterion) {
    let mut group = c.benchmark_group("optimization");

    group.bench_function("engine_creation", |b| {
        b.iter(|| {
            let engine = OptimizationEngine::new();
            black_box(engine);
        });
    });

    group.bench_function("string_optimization", |b| {
        let engine = OptimizationEngine::new();
        b.iter(|| {
            let optimized = engine.optimize_string("test_string_for_optimization");
            black_box(optimized);
        });
    });

    group.finish();
}

fn benchmark_error_handling(c: &mut Criterion) {
    c.bench_function("error_construction", |b| {
        b.iter(|| {
            let error = BearDogError::system("Test error for benchmarking".to_string());
            black_box(error);
        });
    });
}

fn benchmark_async_operations(c: &mut Criterion) {
    let rt = init_benchmark_runtime().expect("Failed to create runtime");

    c.bench_function("async_task_spawn", |b| {
        b.iter(|| {
            rt.block_on(async {
                let task = tokio::spawn(async {
                    tokio::time::sleep(Duration::from_millis(1)).await;
                    42
                });
                let result = task.await.expect("Task execution failed");
                black_box(result);
            });
        });
    });
}

criterion_group!(
    benches,
    benchmark_core_operations,
    benchmark_security_operations,
    benchmark_optimization_engine,
    benchmark_error_handling,
    benchmark_async_operations
);
criterion_main!(benches);
