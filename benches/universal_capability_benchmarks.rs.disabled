//! Universal Capability Discovery Performance Benchmarks
//!
//! These benchmarks validate that the universal capability discovery system
//! meets production performance requirements and outperforms hardcoded approaches.

use beardog_adapters::universal::{
    capability_discovery::UniversalCapabilityDiscovery,
    capability_discovery_cache::{CacheConfig, CachePriority, CapabilityDiscoveryCache},
};
use beardog_types::canonical::capabilities::{
    AuthConfig, CapabilityDiscoveryRequest, CapabilityType, ComplianceLevel, EndpointConfig,
    HealthStatus, PerformanceMetrics, ProviderInfo, SecurityLevel, UniversalCapability,
};
use beardog_types::canonical::providers_unified::core::ProviderType;
use criterion::{black_box, criterion_group, criterion_main, BenchmarkId, Criterion};
use std::collections::HashMap;
use std::time::Duration;
use tokio::runtime::Runtime;

fn create_test_capability(id: &str, cap_type: CapabilityType) -> UniversalCapability {
    UniversalCapability {
        capability_type: cap_type,
        provider: ProviderInfo {
            provider_id: id.to_string(),
            provider_name: format!("Test Provider {}", id),
            provider_type: ProviderType::Vendor,
            version: "1.0.0".to_string(),
            region: Some("test-region".to_string()),
        },
        endpoint: EndpointConfig {
            base_url: format!("http://test-{}.ecosystem.internal", id),
            api_version: Some("v1".to_string()),
            timeout_ms: 5000,
            max_retries: 3,
        },
        auth_config: AuthConfig::None,
        health_status: HealthStatus::Healthy,
        performance: PerformanceMetrics {
            avg_response_time_ms: 50.0,
            success_rate: 0.99,
            throughput_rps: 1000.0,
            current_load: 0.5,
            last_updated: chrono::Utc::now(),
        },
        security_level: SecurityLevel::High,
        metadata: HashMap::new(),
    }
}

fn create_test_capabilities(count: usize) -> Vec<UniversalCapability> {
    let capability_types = vec![
        CapabilityType::KeyManagement,
        CapabilityType::ComputeIntelligence,
        CapabilityType::ServiceMesh,
        CapabilityType::DataStorage,
        CapabilityType::HardwareSecurityModule,
    ];

    (0..count)
        .map(|i| {
            let cap_type = capability_types[i % capability_types.len()].clone();
            create_test_capability(&format!("provider-{}", i), cap_type)
        })
        .collect()
}

fn benchmark_cache_operations(c: &mut Criterion) {
    let mut group = c.benchmark_group("cache_operations");

    // Test different cache sizes
    for cache_size in [100, 500, 1000, 5000].iter() {
        let config = CacheConfig {
            max_entries: *cache_size,
            default_ttl: Duration::from_secs(300),
            ..Default::default()
        };
        let cache = CapabilityDiscoveryCache::new(config);
        let capabilities = create_test_capabilities(*cache_size);

        // Benchmark cache insertion
        group.bench_with_input(
            BenchmarkId::new("insert", cache_size),
            cache_size,
            |b, &_size| {
                b.iter(|| {
                    for (i, capability) in capabilities.iter().enumerate() {
                        cache.insert(
                            black_box(capability.clone()),
                            if i % 10 == 0 {
                                CachePriority::High
                            } else {
                                CachePriority::Normal
                            },
                        );
                    }
                })
            },
        );

        // Populate cache for retrieval tests
        for capability in &capabilities {
            cache.insert(capability.clone(), CachePriority::Normal);
        }

        // Benchmark cache retrieval
        group.bench_with_input(
            BenchmarkId::new("get", cache_size),
            cache_size,
            |b, &_size| {
                b.iter(|| {
                    for i in 0..*cache_size {
                        let id = format!("provider-{}", i);
                        black_box(cache.get(&id));
                    }
                })
            },
        );

        // Benchmark type-based retrieval
        group.bench_with_input(
            BenchmarkId::new("get_by_type", cache_size),
            cache_size,
            |b, &_size| {
                b.iter(|| {
                    black_box(cache.get_by_type(&CapabilityType::KeyManagement));
                })
            },
        );
    }

    group.finish();
}

fn benchmark_discovery_performance(c: &mut Criterion) {
    let rt = Runtime::new().unwrap();
    let mut group = c.benchmark_group("discovery_performance");
    group.sample_size(10); // Reduce sample size for async benchmarks

    // Benchmark capability discovery with different request sizes
    for num_types in [1, 5, 10, 20].iter() {
        let capability_types: Vec<CapabilityType> = vec![
            CapabilityType::KeyManagement,
            CapabilityType::ComputeIntelligence,
            CapabilityType::ServiceMesh,
            CapabilityType::DataStorage,
            CapabilityType::HardwareSecurityModule,
            CapabilityType::SecretsManagement,
            CapabilityType::Authentication,
            CapabilityType::Monitoring,
            CapabilityType::BiometricAuth,
            CapabilityType::QuantumCrypto,
        ]
        .into_iter()
        .take(*num_types)
        .collect();

        group.bench_with_input(
            BenchmarkId::new("discover_capabilities", num_types),
            num_types,
            |b, &_size| {
                b.iter(|| {
                    rt.block_on(async {
                        let discovery = UniversalCapabilityDiscovery::new().await.unwrap();
                        let request = CapabilityDiscoveryRequest {
                            capability_types: black_box(capability_types.clone()),
                            min_security_level: Some(SecurityLevel::High),
                            max_response_time_ms: Some(5000),
                            min_success_rate: Some(0.95),
                            preferred_regions: vec!["us-east-1".to_string()],
                            required_compliance: vec![ComplianceLevel::High],
                        };

                        black_box(discovery.discover_capabilities(request).await)
                    })
                })
            },
        );
    }

    group.finish();
}

fn benchmark_cache_vs_hardcoded(c: &mut Criterion) {
    let mut group = c.benchmark_group("cache_vs_hardcoded");

    // Setup cache with test data
    let cache = CapabilityDiscoveryCache::default();
    let capabilities = create_test_capabilities(1000);
    cache.bulk_insert(
        capabilities
            .into_iter()
            .map(|cap| (cap, CachePriority::Normal))
            .collect(),
    );

    // Benchmark cached lookup (universal approach)
    group.bench_function("universal_cached_lookup", |b| {
        b.iter(|| {
            for i in 0..100 {
                let id = format!("provider-{}", i);
                black_box(cache.get(&id));
            }
        })
    });

    // Simulate hardcoded lookup (legacy approach)
    let hardcoded_map: std::collections::HashMap<String, String> = (0..1000)
        .map(|i| (format!("provider-{}", i), format!("endpoint-{}", i)))
        .collect();

    group.bench_function("hardcoded_map_lookup", |b| {
        b.iter(|| {
            for i in 0..100 {
                let id = format!("provider-{}", i);
                black_box(hardcoded_map.get(&id));
            }
        })
    });

    group.finish();
}

fn benchmark_memory_usage(c: &mut Criterion) {
    let mut group = c.benchmark_group("memory_usage");

    // Test memory efficiency with different cache sizes
    for cache_size in [100, 500, 1000, 5000].iter() {
        let config = CacheConfig {
            max_entries: *cache_size,
            ..Default::default()
        };
        let cache = CapabilityDiscoveryCache::new(config);
        let capabilities = create_test_capabilities(*cache_size);

        group.bench_with_input(
            BenchmarkId::new("memory_efficiency", cache_size),
            cache_size,
            |b, &_size| {
                b.iter(|| {
                    // Bulk insert to test memory efficiency
                    cache.bulk_insert(black_box(
                        capabilities
                            .iter()
                            .cloned()
                            .map(|cap| (cap, CachePriority::Normal))
                            .collect(),
                    ));

                    // Get metrics to ensure memory tracking works
                    black_box(cache.get_metrics());
                })
            },
        );
    }

    group.finish();
}

fn benchmark_concurrent_access(c: &mut Criterion) {
    let rt = Runtime::new().unwrap();
    let mut group = c.benchmark_group("concurrent_access");
    group.sample_size(10);

    let cache = std::sync::Arc::new(CapabilityDiscoveryCache::default());
    let capabilities = create_test_capabilities(1000);
    cache.bulk_insert(
        capabilities
            .into_iter()
            .map(|cap| (cap, CachePriority::Normal))
            .collect(),
    );

    // Benchmark concurrent reads
    group.bench_function("concurrent_reads", |b| {
        b.iter(|| {
            rt.block_on(async {
                let cache = cache.clone();
                let handles: Vec<_> = (0..10)
                    .map(|_| {
                        let cache = cache.clone();
                        tokio::spawn(async move {
                            for i in 0..100 {
                                let id = format!("provider-{}", i);
                                black_box(cache.get(&id));
                            }
                        })
                    })
                    .collect();

                for handle in handles {
                    handle.await.unwrap();
                }
            })
        })
    });

    group.finish();
}

fn benchmark_cache_eviction(c: &mut Criterion) {
    let mut group = c.benchmark_group("cache_eviction");

    // Test LRU eviction performance
    let config = CacheConfig {
        max_entries: 100, // Small cache to force evictions
        ..Default::default()
    };
    let cache = CapabilityDiscoveryCache::new(config);

    group.bench_function("lru_eviction", |b| {
        b.iter(|| {
            // Insert more than max_entries to trigger evictions
            for i in 0..200 {
                let capability = create_test_capability(
                    &format!("eviction-test-{}", i),
                    CapabilityType::KeyManagement,
                );
                cache.insert(black_box(capability), CachePriority::Normal);
            }
        })
    });

    group.finish();
}

fn benchmark_type_filtering(c: &mut Criterion) {
    let mut group = c.benchmark_group("type_filtering");

    let cache = CapabilityDiscoveryCache::default();
    let capabilities = create_test_capabilities(1000);
    cache.bulk_insert(
        capabilities
            .into_iter()
            .map(|cap| (cap, CachePriority::Normal))
            .collect(),
    );

    // Benchmark filtering by different capability types
    let capability_types = vec![
        CapabilityType::KeyManagement,
        CapabilityType::ComputeIntelligence,
        CapabilityType::ServiceMesh,
        CapabilityType::DataStorage,
        CapabilityType::HardwareSecurityModule,
    ];

    for cap_type in capability_types {
        group.bench_with_input(
            BenchmarkId::new("filter_by_type", format!("{:?}", cap_type)),
            &cap_type,
            |b, cap_type| {
                b.iter(|| {
                    black_box(cache.get_by_type(cap_type));
                })
            },
        );
    }

    group.finish();
}

criterion_group!(
    benches,
    benchmark_cache_operations,
    benchmark_discovery_performance,
    benchmark_cache_vs_hardcoded,
    benchmark_memory_usage,
    benchmark_concurrent_access,
    benchmark_cache_eviction,
    benchmark_type_filtering,
);

criterion_main!(benches);
