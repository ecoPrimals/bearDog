//! HSM error path tests for beardog-tunnel
//!
//! Tests error handling in HSM operations

#[cfg(test)]
mod hsm_error_path_tests {
    use beardog_types::hsm::config::HsmConfig;
    use std::time::Duration;

    #[test]
    fn test_hsm_config_default_values() {
        let config = HsmConfig::default();

        // Should have reasonable defaults
        assert!(
            !config.enabled,
            "HSM should be disabled by default for safety"
        );
        assert!(
            !config.software_hsm_path.is_empty(),
            "Should have a default path"
        );
    }

    #[test]
    fn test_hsm_config_timeout_reasonable() {
        let config = HsmConfig::default();

        // Timeout should be reasonable
        let timeout_secs = config.timeout.as_secs();
        assert!(timeout_secs >= 1, "Timeout should be at least 1 second");
        assert!(timeout_secs <= 60, "Timeout should not exceed 60 seconds");
    }

    #[test]
    fn test_hsm_config_max_retries_reasonable() {
        let config = HsmConfig::default();

        // Retries should be reasonable
        assert!(config.max_retries > 0, "Should allow at least 1 retry");
        assert!(
            config.max_retries <= 10,
            "Should not exceed 10 retries to avoid infinite loops"
        );
    }

    #[test]
    fn test_hsm_config_cloneable() {
        let config = HsmConfig::default();
        let cloned = config.clone();

        assert_eq!(config.enabled, cloned.enabled);
        assert_eq!(config.software_hsm_path, cloned.software_hsm_path);
        assert_eq!(config.timeout, cloned.timeout);
        assert_eq!(config.max_retries, cloned.max_retries);
    }

    #[test]
    fn test_hsm_config_debug_output() {
        let config = HsmConfig::default();

        let debug_str = format!("{:?}", config);
        assert!(!debug_str.is_empty());
        assert!(debug_str.contains("HsmConfig"));
    }

    #[test]
    fn test_hsm_config_software_path_not_empty() {
        let config = HsmConfig::default();

        assert!(
            !config.software_hsm_path.is_empty(),
            "Software HSM path must not be empty"
        );
    }

    #[test]
    fn test_hsm_config_timeout_not_zero() {
        let config = HsmConfig::default();

        assert!(!config.timeout.is_zero(), "Timeout must not be zero");
    }

    #[test]
    fn test_hsm_config_custom_timeout() {
        let mut config = HsmConfig::default();
        config.timeout = Duration::from_secs(30);

        assert_eq!(config.timeout.as_secs(), 30);
    }

    #[test]
    fn test_hsm_config_enable_toggle() {
        let mut config = HsmConfig::default();

        // Test toggling enabled state
        assert!(!config.enabled);
        config.enabled = true;
        assert!(config.enabled);
        config.enabled = false;
        assert!(!config.enabled);
    }

    #[test]
    fn test_hsm_config_custom_retry_count() {
        let mut config = HsmConfig::default();
        config.max_retries = 5;

        assert_eq!(config.max_retries, 5);
        assert!(config.max_retries > 0);
    }
}
