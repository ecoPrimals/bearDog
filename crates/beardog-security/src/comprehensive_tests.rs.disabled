// Comprehensive Security Tests
//
// This module contains comprehensive tests for all security functionality
// including key management, encryption, and cryptographic operations.

use super::*;
use beardog_errors::BearDogError;
use std::sync::Arc;
use std::time::Duration;
use tokio::time::timeout;

#[tokio::test]
async fn test_memory_key_manager_basic_operations() -> Result<(), BearDogError> {
    let config = KeyManagerConfig::default();
    let manager = MemoryKeyManager::new(config)?;

    // Test key generation
    let key_id = manager.generate_key()?;
    assert!(!key_id.is_empty());

    // Verify key exists
    assert!(manager.key_exists(&key_id)?);

    Ok(())
}

#[tokio::test]
async fn test_key_deletion() -> Result<(), BearDogError> {
    let config = KeyManagerConfig::default();
    let mut manager = MemoryKeyManager::new(config)?;

    let key_id = manager.generate_key()?;
    assert!(manager.key_exists(&key_id)?);

    manager.delete_key(&key_id)?;
    assert!(!manager.key_exists(&key_id)?);

    Ok(())
}

#[tokio::test]
async fn test_encryption_service_basic_operations() -> Result<(), BearDogError> {
    let config = EncryptionConfig::default();
    let service = EncryptionService::new(config);

    let plaintext = b"Hello, World!";
    let key = generate_secure_random_bytes(32)?;

    let encrypted = service.encrypt(plaintext, &key)?;
    assert_ne!(encrypted, plaintext);

    let decrypted = service.decrypt(&encrypted, &key)?;
    assert_eq!(decrypted, plaintext);

    Ok(())
}

#[tokio::test]
async fn test_hash_functions() -> Result<(), BearDogError> {
    let data = b"test data for hashing";

    let sha256_hash = compute_sha256_hash(data)?;
    assert_eq!(sha256_hash.len(), 32);

    let sha512_hash = compute_sha512_hash(data)?;
    assert_eq!(sha512_hash.len(), 64);

    // Test consistency
    let sha256_hash_2 = compute_sha256_hash(data)?;
    assert_eq!(sha256_hash, sha256_hash_2);

    Ok(())
}

#[tokio::test]
async fn test_random_generation() -> Result<(), BearDogError> {
    let random_bytes_1 = generate_secure_random_bytes(32)?;
    let random_bytes_2 = generate_secure_random_bytes(32)?;

    assert_eq!(random_bytes_1.len(), 32);
    assert_eq!(random_bytes_2.len(), 32);
    assert_ne!(random_bytes_1, random_bytes_2);

    Ok(())
}

#[tokio::test]
async fn test_key_derivation() -> Result<(), BearDogError> {
    let password = b"test_password";
    let salt = b"test_salt_123";

    let derived_key_1 = derive_key_from_password(password, salt, 1000)?;
    let derived_key_2 = derive_key_from_password(password, salt, 1000)?;

    assert_eq!(derived_key_1, derived_key_2);

    // Test with different salt
    let different_salt = b"different_salt";
    let derived_key_3 = derive_key_from_password(password, different_salt, 1000)?;
    assert_ne!(derived_key_1, derived_key_3);

    Ok(())
}

#[tokio::test]
async fn test_constant_time_comparison() -> Result<(), BearDogError> {
    let data_1 = b"identical_data";
    let data_2 = b"identical_data";
    let data_3 = b"different_data";

    assert!(constant_time_compare(data_1, data_2));
    assert!(!constant_time_compare(data_1, data_3));

    Ok(())
}

#[tokio::test]
async fn test_secure_memory_zeroing() -> Result<(), BearDogError> {
    let mut sensitive_data = vec![0xAA; 32];
    assert_eq!(sensitive_data[0], 0xAA);

    secure_zero_memory(&mut sensitive_data);
    assert_eq!(sensitive_data[0], 0x00);
    assert!(sensitive_data.iter().all(|&x| x == 0));

    Ok(())
}

#[tokio::test]
async fn test_key_manager_stress() -> Result<(), BearDogError> {
    let config = KeyManagerConfig::default();
    let manager = MemoryKeyManager::new(config)?;

    let mut key_ids = Vec::new();
    for _ in 0..10 {
        let key_id = manager.generate_key()?;
        key_ids.push(key_id);
    }

    for key_id in &key_ids {
        assert!(manager.key_exists(key_id)?);
    }

    // Delete first 5 keys
    for key_id in &key_ids[0..5] {
        let mut manager_mut = manager.clone();
        manager_mut.delete_key(key_id)?;
    }

    for key_id in &key_ids[5..10] {
        assert!(manager.key_exists(key_id)?);
    }

    Ok(())
}

#[tokio::test]
async fn test_encryption_with_different_key_sizes() -> Result<(), BearDogError> {
    let config = EncryptionConfig::default();
    let service = EncryptionService::new(config);

    let plaintext = b"Test message for encryption";
    let key_256 = generate_secure_random_bytes(32)?;

    let encrypted_256 = service.encrypt_data(plaintext, &key_256)?;
    let decrypted_256 = service.decrypt_data(&encrypted_256, &key_256)?;
    assert_eq!(decrypted_256, plaintext);

    Ok(())
}

#[tokio::test]
async fn test_concurrent_encryption_operations() -> Result<(), BearDogError> {
    let config = EncryptionConfig::default();
    let service = Arc::new(EncryptionService::new(config));
    let key = generate_secure_random_bytes(32)?;

    let mut handles = Vec::new();

    for i in 0..10 {
        let service_clone = Arc::clone(&service);
        let key_clone = key.clone();
        let handle = tokio::spawn(async move {
            let plaintext = format!("Test message {}", i);
            let encrypted = service_clone.encrypt_data(plaintext.as_bytes(), &key_clone)?;
            let decrypted = service_clone.decrypt_data(&encrypted, &key_clone)?;
            assert_eq!(decrypted, plaintext.as_bytes());
            Ok::<(), BearDogError>(())
        });
        handles.push(handle);
    }

    for handle in handles {
        let result = timeout(Duration::from_secs(5), handle)
            .await
            .map_err(|_| BearDogError::System {
                message: "Timeout waiting for task".to_string(),
                category: beardog_errors::SystemErrorCategory::General,
            })?
            .map_err(|e| BearDogError::System {
                message: format!("Join error: {:?}", e),
                category: beardog_errors::SystemErrorCategory::General,
            })?;
        result?;
    }

    Ok(())
}

#[tokio::test]
async fn test_encryption_with_wrong_key() -> Result<(), BearDogError> {
    let config = EncryptionConfig::default();
    let service = EncryptionService::new(config);

    let plaintext = b"Secret message";
    let key = generate_secure_random_bytes(32)?;
    let wrong_key = generate_secure_random_bytes(32)?;

    let encrypted = service.encrypt_data(plaintext, &key)?;

    // Try to decrypt with wrong key - should not match original
    let decrypt_result = service.decrypt_data(&encrypted, &wrong_key);
    assert!(decrypt_result.is_ok()); // XOR always succeeds
    let decrypted = decrypt_result?;
    assert_ne!(decrypted, plaintext); // But result should be different

    Ok(())
}

#[tokio::test]
async fn test_key_manager_error_handling() -> Result<(), BearDogError> {
    let config = KeyManagerConfig::default();
    let manager = MemoryKeyManager::new(config)?;

    // Test operations on non-existent key
    assert!(!manager.key_exists("non_existent_key")?);

    // Test deletion of non-existent key (should not fail)
    let mut manager_mut = manager.clone();
    let delete_result = manager_mut.delete_key("non_existent_key");
    assert!(delete_result.is_ok());

    Ok(())
}

#[tokio::test]
async fn test_encryption_service_configuration() -> Result<(), BearDogError> {
    let config = EncryptionConfig {
        algorithm: EncryptionAlgorithm::Aes256Gcm,
        key_size: 32,
    };

    let service = EncryptionService::new(config.clone());
    assert!(service.is_initialized());

    Ok(())
}

#[tokio::test]
async fn test_integrated_key_management_and_encryption() -> Result<(), BearDogError> {
    // Integration test combining key management and encryption
    let key_config = KeyManagerConfig::default();
    let key_manager = MemoryKeyManager::new(key_config)?;

    let encryption_config = EncryptionConfig::default();
    let encryption_service = EncryptionService::new(encryption_config);

    // Generate a key using the key manager
    let key_id = key_manager.generate_key()?;
    assert!(key_manager.key_exists(&key_id)?);

    // Get the key data (in real implementation, this would be the actual key)
    let encryption_key = generate_secure_random_bytes(32)?;

    // Test data
    let test_data = b"Integration test data";

    // Encrypt using the encryption service
    let encrypted = encryption_service.encrypt_data(test_data, &encryption_key)?;

    let decrypted = encryption_service.decrypt_data(&encrypted, &encryption_key)?;

    assert_eq!(decrypted, test_data);

    // Test hash operations
    let hash = compute_sha256_hash(test_data)?;
    assert_eq!(hash.len(), 32);

    // Test random generation
    let random_data = generate_secure_random_bytes(64)?;
    assert_eq!(random_data.len(), 64);

    // Clean up
    let mut key_manager_mut = key_manager.clone();
    key_manager_mut.delete_key(&key_id)?;
    assert!(!key_manager.key_exists(&key_id)?);

    Ok(())
}
