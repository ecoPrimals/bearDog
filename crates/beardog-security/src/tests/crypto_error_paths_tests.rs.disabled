//! Crypto Error Path Tests - October 19, 2025
//!
//! Tests for error handling in cryptographic operations.
//! Focus on edge cases and failure scenarios to improve coverage.

use crate::crypto_utils::unified::{hash_data, verify_hash};
use beardog_errors::BearDogError;

#[test]
fn test_hash_empty_data() {
    // Empty data should still produce a valid hash
    let data = b"";
    let result = hash_data(data);
    assert!(result.is_ok());
    let hash = result.unwrap();
    assert!(!hash.is_empty());
    assert_eq!(hash.len(), 32); // SHA256 produces 32 bytes
}

#[test]
fn test_hash_large_data() {
    // Test with large data to ensure no buffer issues
    let data = vec![0u8; 1024 * 1024]; // 1MB
    let result = hash_data(&data);
    assert!(result.is_ok());
    let hash = result.unwrap();
    assert_eq!(hash.len(), 32);
}

#[test]
fn test_verify_hash_mismatch() {
    // Test hash verification with wrong hash
    let data = b"test data";
    let wrong_hash = vec![0u8; 32];

    let result = verify_hash(data, &wrong_hash);
    assert!(result.is_ok());
    assert!(!result.unwrap()); // Should return false, not error
}

#[test]
fn test_verify_hash_invalid_length() {
    // Test with invalid hash length
    let data = b"test data";
    let invalid_hash = vec![0u8; 16]; // Wrong length

    let result = verify_hash(data, &invalid_hash);
    assert!(result.is_err());

    if let Err(err) = result {
        match err {
            BearDogError::Validation { .. } => {
                // Expected error type
            }
            _ => panic!("Expected Validation error for invalid hash length"),
        }
    }
}

#[test]
fn test_hash_consistency() {
    // Same input should produce same hash
    let data = b"consistent data";

    let hash1 = hash_data(data).unwrap();
    let hash2 = hash_data(data).unwrap();

    assert_eq!(hash1, hash2);
}

#[test]
fn test_hash_different_inputs() {
    // Different inputs should produce different hashes
    let data1 = b"data1";
    let data2 = b"data2";

    let hash1 = hash_data(data1).unwrap();
    let hash2 = hash_data(data2).unwrap();

    assert_ne!(hash1, hash2);
}

#[test]
fn test_hash_single_bit_difference() {
    // Avalanche effect: single bit change should drastically change hash
    let data1 = b"test data";
    let mut data2 = b"test data".to_vec();
    data2[0] ^= 0x01; // Flip one bit

    let hash1 = hash_data(data1).unwrap();
    let hash2 = hash_data(&data2).unwrap();

    assert_ne!(hash1, hash2);

    // Check significant difference (at least 50% of bits different)
    let diff_bits: usize = hash1
        .iter()
        .zip(hash2.iter())
        .map(|(a, b)| (a ^ b).count_ones() as usize)
        .sum();

    assert!(diff_bits > 128); // At least half of 256 bits should differ
}

#[test]
fn test_verify_hash_correct() {
    // Verify correct hash succeeds
    let data = b"correct data";
    let hash = hash_data(data).unwrap();

    let result = verify_hash(data, &hash);
    assert!(result.is_ok());
    assert!(result.unwrap());
}

#[test]
fn test_hash_unicode_data() {
    // Test with unicode data
    let data = "Hello 世界 🐻🔐".as_bytes();
    let result = hash_data(data);
    assert!(result.is_ok());

    // Verify it's reproducible
    let hash1 = hash_data(data).unwrap();
    let hash2 = hash_data(data).unwrap();
    assert_eq!(hash1, hash2);
}

#[test]
fn test_hash_boundary_sizes() {
    // Test various boundary sizes
    let sizes = vec![0, 1, 63, 64, 65, 127, 128, 129, 255, 256, 512, 1024];

    for size in sizes {
        let data = vec![0xAA; size];
        let result = hash_data(&data);
        assert!(result.is_ok(), "Failed for size {}", size);
        assert_eq!(
            result.unwrap().len(),
            32,
            "Wrong hash length for size {}",
            size
        );
    }
}
