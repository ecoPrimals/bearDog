/// Custom result types for workflow processing
// Use canonical WorkflowExecutionStatus from types module
// Use canonical WorkflowMetrics from types module
#[derive(Debug, Clone, serde::Serialize, serde::Deserialize)]
pub struct BatchWorkflowResult {
    pub workflow_id: String,
    pub processor_name: String,
    pub status: String,
    pub duration_ms: u64,
    pub steps_completed: u32,
    pub output_size: usize,
    pub warnings_count: usize,
}

#[cfg(test)]
mod tests {
    use super::*;
    // ApprovalRequirements removed - using Option<ApprovalRequirements> in CanonicalWorkflow


    fn create_test_workflow(workflow_type: WorkflowType) -> Workflow {
        Workflow {
            id: format!("test_workflow_{}", uuid::Uuid::new_v4()),
            workflow_type,
            status: WorkflowStatus::Pending,
            priority: beardog_types::canonical::workflow::WorkflowPriority::Normal,
            created_at: chrono::Utc::now(),
            updated_at: chrono::Utc::now(),
            initiator: "test_user".to_string(),
            requested_by: "test_user".to_string(),
            target: "test_target".to_string(),
            description: Some("A test workflow for validation".to_string()),
            expires_at: None,
            timeout_duration: None,
            metadata: HashMap::new(),
            parameters: HashMap::new(),
            properties: HashMap::new(),
            context: crate::workflows::canonical::WorkflowContext::default(),
            approval_requirements: None,
            approvals: Vec::new(),
            audit_trail: Vec::new(),
    #[tokio::test]
    async fn test_improved_workflow_processing() -> BearDogResult<()> {
        let workflow = create_test_workflow(WorkflowType::Compliance);
        let result = process_workflow_improved(&workflow, "TestProcessor").await;
        assert!(result.is_ok());
        let processing_outcome =
            result.map_err(|e| BearDogError::internal(format!("Processing test failed: {}", e)))?;
        assert_eq!(processing_outcome.statistics.total_items, 1);
        assert!(processing_outcome.statistics.successful_items >= 1);
        assert!(!processing_outcome.items.is_empty());
        assert_eq!(
            processing_outcome.items[0].processor_name,
            "ComplianceProcessor"
        );
        Ok(())
    }

    #[tokio::test]
    async fn test_batch_workflow_processing() -> BearDogResult<()> {
        let workflows = vec![
            create_test_workflow(WorkflowType::Authentication),
            create_test_workflow(WorkflowType::KeyManagement),
            create_test_workflow(WorkflowType::Monitoring),
        ];
        let result = process_workflows_batch_improved(workflows).await;
        let batch_outcome = result
            .map_err(|e| BearDogError::internal(format!("Batch processing test failed: {}", e)))?;
        assert_eq!(batch_outcome.statistics.total_items, 3);
        assert!(batch_outcome.statistics.successful_items >= 1);
    async fn test_workflow_validation() -> BearDogResult<()> {
        let result = validate_workflow_improved(&workflow).await;
        let validation =
            result.map_err(|e| BearDogError::internal(format!("Validation test failed: {}", e)))?;
        // Use correct ValidationOutcome fields
            validation.status,
            beardog_errors::improved_results::ValidationStatus::Passed
        assert!(validation.findings.is_empty()); // No findings means valid
        Ok(())
    }

    #[tokio::test]
    async fn test_workflow_validation_failure() -> BearDogResult<()> {
        let mut workflow = create_test_workflow(WorkflowType::Compliance);
        workflow.id = "".to_string(); // Invalid ID
        workflow.target = "".to_string(); // No target
        
        let validation = validate_workflow_improved(&workflow).await?;
        
        assert_eq!(validation.status, 
            beardog_errors::improved_results::ValidationStatus::Failed);
        assert!(!validation.findings.is_empty()); // Should have findings for failures
        Ok(())
    }
}
