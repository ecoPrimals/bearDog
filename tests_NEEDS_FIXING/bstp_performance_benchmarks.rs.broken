use beardog::config::EncryptionConfig;
use beardog::encryption::EncryptionEngine;
use beardog::genetics::handlers::DefaultBearDogGeneticsEngine;
use beardog::genetics::types::{GeneticsConfig, InMemoryGeneticsStore};
use beardog::tunnel::{
    genetic_healing::{SecurityIssue, SecurityIssueType, Severity},
    BStpConfig, BStpKeyManager, CryptoAlgorithm, GamingCryptoEngine, GeneticSecurityHealing,
    SecurityGenetics,
};
use beardog_errors::BearDogError;
use std::sync::Arc;
use std::time::{Duration, Instant};

#[tokio::test]
async fn benchmark_starcraft2_gaming_scenario() -> Result<(), BearDogError> {
    println!("🎮 Benchmarking StarCraft 2 gaming performance...");

    let config = BStpConfig::competitive_gaming();
    let encryption = Arc::new(EncryptionEngine::new(EncryptionConfig::default()).await?);
    let genetics_store = Arc::new(InMemoryGeneticsStore::new());
    let genetics = Arc::new(DefaultBearDogGeneticsEngine::new(
        genetics_store,
        GeneticsConfig::default(),
    ));
    let key_manager = Arc::new(BStpKeyManager::new(config.key_management.clone()).await?);

    let crypto_engine =
        GamingCryptoEngine::new(encryption, genetics, key_manager, config.clone()).await?;

    let security_genetics = SecurityGenetics::default();

    let sc2_packets = vec![
        (b"player_select_units".to_vec(), "Unit Selection"),
        (
            b"player_move_command_xyz_coordinates_1234_5678".to_vec(),
            "Move Command",
        ),
        (
            b"player_attack_target_unit_id_9999".to_vec(),
            "Attack Command",
        ),
        (
            b"player_build_structure_barracks_location_xy".to_vec(),
            "Build Command",
        ),
        (
            b"player_cast_spell_psionic_storm_area_effect".to_vec(),
            "Spell Cast",
        ),
    ];

    let mut total_times = Vec::new();
    let iterations = 1000; // 1000 iterations for statistical significance

    for (packet_data, packet_type) in &sc2_packets {
        let mut encryption_times = Vec::new();
        let mut decryption_times = Vec::new();

        for i in 0..iterations {
            let session_id = format!("sc2_session_{packet_type}_{i}");

            let start = Instant::now();
            let encrypted = crypto_engine
                .ultra_fast_encrypt(&session_id, packet_data, &security_genetics)
                .await?;
            let encryption_time = start.elapsed();
            encryption_times.push(encryption_time);

            let start = Instant::now();
            let decrypted = crypto_engine
                .ultra_fast_decrypt(&session_id, &encrypted, &security_genetics)
                .await?;
            let decryption_time = start.elapsed();
            decryption_times.push(decryption_time);

            assert_eq!(packet_data, &decrypted);
        }

        let avg_encryption = encryption_times.iter().sum::<Duration>() / iterations as u32;
        let avg_decryption = decryption_times.iter().sum::<Duration>() / iterations as u32;

        let max_encryption = encryption_times.iter().max().ok_or_else(|| {
            beardog_errors::BearDogError::internal("No encryption times recorded".to_string())
        })?;
        let max_decryption = decryption_times.iter().max().ok_or_else(|| {
            beardog_errors::BearDogError::internal("No decryption times recorded".to_string())
        })?;

        let min_encryption = encryption_times.iter().min().ok_or_else(|| {
            beardog_errors::BearDogError::internal("No encryption times recorded".to_string())
        })?;
        let min_decryption = decryption_times.iter().min().ok_or_else(|| {
            beardog_errors::BearDogError::internal("No decryption times recorded".to_string())
        })?;

        println!("📊 {packet_type} Performance:");
        println!(
            "   Encryption - Avg: {}μs, Min: {}μs, Max: {}μs",
            avg_encryption.as_micros({}μs, Min: {}μs, Max: {}μs",
            avg_decryption.as_micros(),
            min_decryption.as_micros(),
            max_decryption.as_micros()
        );

        assert!(
            avg_encryption <= config.performance.max_encryption_latency,
            "Average encryption {}μs exceeds target {}μs for {}",
            avg_encryption.as_micros(),
            config.performance.max_encryption_latency.as_micros(),
            packet_type
        );

        assert!(
            avg_decryption <= config.performance.max_decryption_latency,
            "Average decryption {}μs exceeds target {}μs for {}",
            avg_decryption.as_micros(),
            config.performance.max_decryption_latency.as_micros(),
            packet_type
        );

        total_times.push((avg_encryption, avg_decryption));
    }

    let overall_avg_encryption: Duration =
        total_times.iter().map(|(e, _)| *e).sum::<Duration>() / total_times.len() as u32;
    let overall_avg_decryption: Duration =
        total_times.iter().map(|(_, d)| *d).sum::<Duration>() / total_times.len() as u32;

    println!("🏆 StarCraft 2 Overall Performance:");
    println!(
        "   Average Encryption: {}μs (Target: {}μs)",
        overall_avg_encryption.as_micros(),
        config.performance.max_encryption_latency.as_micros()
    );
    println!(
        "   Average Decryption: {}μs (Target: {}μs)",
        overall_avg_decryption.as_micros(),
        config.performance.max_decryption_latency.as_micros()
    );

    Ok(())
}

#[tokio::test]
async fn benchmark_age_of_empires2_scenario() -> Result<(), BearDogError> {
    println!("🏰 Benchmarking Age of Empires 2 gaming performance...");

    let config = BStpConfig::competitive_gaming();
    let encryption = Arc::new(EncryptionEngine::new(EncryptionConfig::default()).await?);
    let genetics_store = Arc::new(InMemoryGeneticsStore::new());
    let genetics = Arc::new(DefaultBearDogGeneticsEngine::new(
        genetics_store,
        GeneticsConfig::default(),
    ));
    let key_manager = Arc::new(BStpKeyManager::new(config.key_management.clone()).await?);

    let crypto_engine =
        GamingCryptoEngine::new(encryption, genetics, key_manager, config.clone()).await?;

    let security_genetics = SecurityGenetics::default();

    let aoe2_commands = vec![
        b"villager_gather_wood_forest_1".to_vec(),
        b"military_unit_attack_enemy_castle".to_vec(),
        b"build_house_coordinates_x100_y200".to_vec(),
        b"research_technology_bloodlines".to_vec(),
        b"trade_cart_move_to_market".to_vec(),
    ];

    let iterations = 500;
    let mut all_latencies = Vec::new();

    for command in &aoe2_commands {
        for i in 0..iterations {
            let session_id = format!("aoe2_session_{i}");

            let start = Instant::now();
            let encrypted = crypto_engine
                .ultra_fast_encrypt(&session_id, command, &security_genetics)
                .await?;
            let decrypted = crypto_engine
                .ultra_fast_decrypt(&session_id, &encrypted, &security_genetics)
                .await?;
            let total_latency = start.elapsed();

            assert_eq!(command, &decrypted);
            all_latencies.push(total_latency);
        }
    }

    all_latencies.sort();
    let p50 = all_latencies[all_latencies.len() / 2];
    let p95 = all_latencies[(all_latencies.len() * 95) / 100];
    let p99 = all_latencies[(all_latencies.len() * 99) / 100];
    let max_latency = all_latencies.last().ok_or_else(|| {
        tracing::error!("Collection is empty when accessing last element");
        beardog_errors::BearDogError::validation("Collection is empty")
    })?;

    println!("📊 Age of Empires 2 Latency Percentiles:");
    println!("   P50 (Median): {}μs", p50.as_micros({}μs", p95.as_micros({}μs", p99.as_micros({}μs", max_latency.as_micros());

    let aoe2_target = Duration::from_micros(200); // 200μs target for AoE2
    assert!(
        p95 <= aoe2_target,
        "P95 latency {}μs exceeds AoE2 target {}μs",
        p95.as_micros(),
        aoe2_target.as_micros()
    );

    Ok(())
}

#[tokio::test]
async fn benchmark_throughput_stress_test() -> Result<(), BearDogError> {
    println!("⚡ Benchmarking throughput under stress...");

    let config = BStpConfig::competitive_gaming();
    let encryption = Arc::new(EncryptionEngine::new(EncryptionConfig::default()).await?);
    let genetics_store = Arc::new(InMemoryGeneticsStore::new());
    let genetics = Arc::new(DefaultBearDogGeneticsEngine::new(
        genetics_store,
        GeneticsConfig::default(),
    ));
    let key_manager = Arc::new(BStpKeyManager::new(config.key_management.clone()).await?);

    let crypto_engine =
        Arc::new(GamingCryptoEngine::new(encryption, genetics, key_manager, config.clone()).await?);

    let security_genetics = SecurityGenetics::default();

    let packet_sizes = vec![64, 256, 512, 1024, 1500]; // Common network packet sizes
    let packets_per_size = 1000;

    for &size in &packet_sizes {
        let test_data = vec![0u8; size];
        let mut handles = Vec::new();

        let start_time = Instant::now();

        for i in 0..packets_per_size {
            let crypto = crypto_engine.clone();
            let data = test_data.clone();
            let genetics = security_genetics.clone();

            let handle = tokio::spawn(async move {
                let session_id = format!("stress_test_{size}_{i}");

                let encrypted = crypto
                    .ultra_fast_encrypt(&session_id, &data, &genetics)
                    .await?;

                let decrypted = crypto
                    .ultra_fast_decrypt(&session_id, &encrypted, &genetics)
                    .await?;

                assert_eq!(data, decrypted);
                Ok::<(), beardog::BearDogError>(())
            });

            handles.push(handle);
        }

        for handle in handles {
            handle
                .await
                .map_err(|e| beardog::BearDogError::OperationTimeout {
                    operation: e.to_string(),
                })??;
        }

        let total_time = start_time.elapsed();
        let throughput_mbps =
            (size * packets_per_size * 8) as f64 / total_time.as_secs_f64() / 1_000_000.0;
        let packets_per_second = packets_per_size as f64 / total_time.as_secs_f64();

        println!("📊 Packet Size {size}B Performance:");
        println!("   Throughput: {throughput_mbps:.2} Mbps");
        println!("   Packets/sec: {packets_per_second:.0}");
        println!("   Total time: {:.2}s", total_time.as_secs_f64());

        let min_throughput_mbps = config.performance.min_gaming_throughput;
        assert!(
            throughput_mbps >= min_throughput_mbps as f64,
            "Throughput {throughput_mbps:.2} Mbps below target {min_throughput_mbps:.2} Mbps for {size}B packets"
        );
    }

    Ok(())
}

#[tokio::test]
async fn benchmark_genetic_healing_performance() -> Result<(), BearDogError> {
    println!("🧬 Benchmarking genetic healing performance...");

    let genetics_store = Arc::new(InMemoryGeneticsStore::new());
    let genetics = Arc::new(DefaultBearDogGeneticsEngine::new(
        genetics_store,
        GeneticsConfig::default(),
    ));
    let mut healing = GeneticSecurityHealing::new(genetics).await?;

    let threat_types = vec![
        SecurityIssueType::EncryptionCompromised,
        SecurityIssueType::AuthenticationBreach,
        SecurityIssueType::PerformanceDegradation,
        SecurityIssueType::NetworkAnomaly,
    ];

    let iterations = 100;

    for threat_type in threat_types {
        let mut healing_times = Vec::new();

        for i in 0..iterations {
            let security_issue = SecurityIssue {
                issue_type: threat_type.clone(Severity::High,
                description: format!("Test threat {i}"),
                timestamp: std::time::SystemTime::now(),
            };

            let start = Instant::now();
            let result = healing.heal_security_issue(security_issue).await?;
            let healing_time = start.elapsed();

            assert_eq!(result, beardog::tunnel::HealingResult::Success);
            healing_times.push(healing_time);
        }

        let avg_healing_time = healing_times.iter().sum::<Duration>() / iterations as u32;
        let max_healing_time = healing_times.iter().max().map_err(|e| {
            tracing::error!("Operation failed: {:?}", e);
            beardog_errors::BearDogError::internal({:?}", e))
        })?;

        println!("🧬 {threat_type:?} Healing Performance:");
        println!("   Average: {}ms", avg_healing_time.as_millis({}ms", max_healing_time.as_millis());

        let max_acceptable = Duration::from_millis(50); // 50ms max for gaming
        assert!(
            avg_healing_time <= max_acceptable,
            "Average healing time {}ms exceeds target {}ms for {:?}",
            avg_healing_time.as_millis(),
            max_acceptable.as_millis(),
            threat_type
        );
    }

    Ok(())
}

#[tokio::test]
async fn benchmark_key_management_performance() -> Result<(), BearDogError> {
    println!("🔑 Benchmarking key management performance...");

    let config = BStpConfig::competitive_gaming();
    let key_manager = Arc::new(BStpKeyManager::new(config.key_management.clone()).await?);

    let operations = 1000;

    let start = Instant::now();
    let mut generation_times = Vec::new();

    for i in 0..operations {
        let session_id = format!("perf_test_session_{i}");

        let gen_start = Instant::now();
        let _key = key_manager
            .generate_session_key(&session_id, CryptoAlgorithm::ChaCha20Poly1305)
            .await?;
        generation_times.push(gen_start.elapsed());
    }

    let total_generation_time = start.elapsed();
    let avg_generation_time = generation_times.iter().sum::<Duration>() / operations as u32;

    println!("🔑 Key Management Performance:");
    println!("   Key Generation:");
    println!("     Average: {}μs", avg_generation_time.as_micros({:.2}s",
        total_generation_time.as_secs_f64({:.0}",
        operations as f64 / total_generation_time.as_secs_f64()
    );

    assert!(
        avg_generation_time <= Duration::from_micros(500),
        "Key generation too slow"
    );

    Ok(())
}
