# BearDog Environment Configuration
# Copy this file to .env and configure for your environment
# 
# All configuration is environment-driven following primal sovereignty principles:
# - No hardcoded IPs, ports, or service names
# - Runtime discovery of other primals
# - Self-knowledge only

# ==============================================================================
# CORE IDENTITY (REQUIRED)
# ==============================================================================

# Genetic family identifier - defines trust boundaries
FAMILY_ID=nat0

# Unique node identifier within the family
NODE_ID=tower1

# ==============================================================================
# HSM CONFIGURATION
# ==============================================================================

# HSM mode: software | yubikey | tpm | android_strongbox | ios_secure_enclave
BEARDOG_HSM_MODE=software

# YubiKey-specific (optional)
# BEARDOG_YUBIKEY_SERIAL=12345678

# TPM-specific (optional)
# BEARDOG_TPM_PATH=/dev/tpm0

# ==============================================================================
# NETWORK CONFIGURATION
# ==============================================================================

# HTTP API bind address (optional - use Unix sockets when possible)
# Default: 0.0.0.0:0 (random port to avoid conflicts)
# Set to empty to disable HTTP entirely
BEARDOG_BIND_ADDR=0.0.0.0:0

# External endpoint URL (for registration with discovery services)
# If not set, constructed from BEARDOG_HOST and port
# BEARDOG_ENDPOINT=http://server.example.com:9000

# Host for endpoint construction (if BEARDOG_ENDPOINT not set)
# Default: localhost
# BEARDOG_HOST=server.example.com

# API port (used for endpoint construction)
# Default: 9000
# BEARDOG_API_PORT=9000

# ==============================================================================
# UNIX SOCKET IPC (PRIMARY)
# ==============================================================================

# Unix socket path is automatically constructed as:
# /tmp/beardog-${FAMILY_ID}-${NODE_ID}.sock
#
# For custom path, you would modify the code to read:
# BEARDOG_IPC_SOCKET=/var/run/beardog.sock

# ==============================================================================
# REGISTRY & DISCOVERY
# ==============================================================================

# Primal registry Unix socket
# Default: /tmp/primal-registry-${FAMILY_ID}.sock
# PRIMAL_REGISTRY_SOCKET=/var/run/primal-registry.sock

# Universal Primal Adapter (UPA) URL
# Default: https://localhost:8080
# BEARDOG_UPA_URL=https://upa.example.com:8080

# ==============================================================================
# SERVICE CONFIGURATION
# ==============================================================================

# Service name for registration
# Default: beardog-security-provider
# BEARDOG_SERVICE_NAME=beardog-prod

# Heartbeat interval in seconds
# Default: 30
# BEARDOG_HEARTBEAT_INTERVAL=60

# ==============================================================================
# LOGGING & MONITORING
# ==============================================================================

# Rust log level: error | warn | info | debug | trace
# Default: info
RUST_LOG=info

# More specific logging:
# RUST_LOG=beardog=debug,beardog_tunnel=trace

# JSON structured logging (for production)
# BEARDOG_LOG_FORMAT=json

# Log file path (optional - defaults to stdout)
# BEARDOG_LOG_FILE=/var/log/beardog/beardog.log

# ==============================================================================
# SECURITY & TRUST
# ==============================================================================

# Trust evaluation strictness: strict | lenient | permissive
# Default: strict
# BEARDOG_TRUST_MODE=strict

# Enable mutual TLS for HTTP API (if HTTP enabled)
# Default: false
# BEARDOG_MTLS_ENABLED=true

# TLS certificate path (if MTLS enabled)
# BEARDOG_TLS_CERT=/etc/beardog/certs/server.crt
# BEARDOG_TLS_KEY=/etc/beardog/certs/server.key

# ==============================================================================
# PERFORMANCE TUNING
# ==============================================================================

# Thread pool size (optional - defaults to CPU count)
# BEARDOG_WORKER_THREADS=4

# Connection pool size
# Default: 100
# BEARDOG_CONNECTION_POOL_SIZE=200

# Request timeout in seconds
# Default: 30
# BEARDOG_REQUEST_TIMEOUT=60

# ==============================================================================
# DEVELOPMENT & TESTING
# ==============================================================================

# Enable development mode (relaxed security, verbose logging)
# BEARDOG_DEV_MODE=true

# Enable API documentation endpoint
# BEARDOG_API_DOCS_ENABLED=true

# Metrics endpoint enabled
# Default: true
# BEARDOG_METRICS_ENABLED=true

# ==============================================================================
# PRIMAL SOVEREIGNTY NOTES
# ==============================================================================
#
# BearDog follows "primal sovereignty" principles:
#
# 1. SELF-KNOWLEDGE ONLY
#    - BearDog knows FAMILY_ID and NODE_ID (from environment)
#    - Does NOT hardcode knowledge of other primals
#
# 2. RUNTIME DISCOVERY
#    - Discovers other primals via registry/discovery services
#    - Uses Unix sockets for local IPC (no ports)
#    - Uses UDP multicast for network discovery (via Songbird)
#
# 3. CAPABILITY-BASED
#    - Advertises capabilities: ["security", "encryption", "trust"]
#    - Other primals discover and use via capability interface
#
# 4. ZERO HARDCODING
#    - No hardcoded IPs, ports, or service names
#    - All configuration via environment variables
#    - Smart defaults for development experience
#
# ==============================================================================

# ==============================================================================
# EXAMPLE CONFIGURATIONS
# ==============================================================================

# --- Single Development Instance ---
# FAMILY_ID=dev
# NODE_ID=dev-1
# BEARDOG_HSM_MODE=software
# BEARDOG_BIND_ADDR=0.0.0.0:9000
# RUST_LOG=debug

# --- Production Tower (Primary) ---
# FAMILY_ID=prod
# NODE_ID=tower1
# BEARDOG_HSM_MODE=yubikey
# BEARDOG_BIND_ADDR=  # Empty = Unix socket only
# BEARDOG_TRUST_MODE=strict
# BEARDOG_MTLS_ENABLED=true
# RUST_LOG=info

# --- Production Tower (Secondary) ---
# FAMILY_ID=prod
# NODE_ID=tower2
# BEARDOG_HSM_MODE=tpm
# BEARDOG_BIND_ADDR=  # Empty = Unix socket only
# BEARDOG_TRUST_MODE=strict
# RUST_LOG=info

# --- Dual Towers on Same Machine (Testing) ---
# Terminal 1:
#   FAMILY_ID=nat0 NODE_ID=tower1 BEARDOG_HSM_MODE=software ./beardog server
#
# Terminal 2:
#   FAMILY_ID=nat0 NODE_ID=tower2 BEARDOG_HSM_MODE=software ./beardog server
#
# Both will create unique Unix sockets:
#   /tmp/beardog-nat0-tower1.sock
#   /tmp/beardog-nat0-tower2.sock

