}

#==============================================================================
# Main Experiment Flow
#==============================================================================

main() {
    intro
    collect_keyboard_entropy
    collect_mouse_entropy
    collect_microphone_entropy
    collect_system_entropy
    mix_entropy_sources
    generate_analysis
    show_summary
}

# Run the experiment
main "$@"

