{
  "scenario_name": "Distributed Key Registry Operations",
  "scenario_id": "dkr-ops-001",
  "operation": "distributed_key_management",
  "cluster_config": {
    "num_nodes": 4,
    "fault_tolerance": 1,
    "consensus_algorithm": "pbft"
  },
  "operations": [
    {
      "op_id": "OP-001",
      "operation": "register_key",
      "description": "Register new key to registry",
      "key_id": "key-alpha",
      "proposing_node": "node-a"
    },
    {
      "op_id": "OP-002",
      "operation": "register_key",
      "description": "Register another key",
      "key_id": "key-beta",
      "proposing_node": "node-b"
    },
    {
      "op_id": "OP-003",
      "operation": "discover_key",
      "description": "Discover key from different node",
      "key_id": "key-alpha",
      "querying_node": "node-c"
    },
    {
      "op_id": "OP-004",
      "operation": "update_key",
      "description": "Update existing key (new version)",
      "key_id": "key-alpha",
      "proposing_node": "node-d"
    },
    {
      "op_id": "OP-005",
      "operation": "concurrent_update",
      "description": "Concurrent updates from different nodes (conflict)",
      "key_id": "key-beta",
      "nodes": ["node-a", "node-c"]
    }
  ],
  "test_cases": [
    {
      "test_id": "TC-001",
      "description": "Key registration with consensus (should PASS)",
      "operation": "register_key",
      "expected_result": "success",
      "expected_votes": 3
    },
    {
      "test_id": "TC-002",
      "description": "Key discovery from any node (should PASS)",
      "operation": "discover_key",
      "expected_result": "success",
      "expected_consistency": true
    },
    {
      "test_id": "TC-003",
      "description": "Consensus with 3/4 nodes (should PASS)",
      "operation": "register_key",
      "active_nodes": 3,
      "expected_result": "success"
    },
    {
      "test_id": "TC-004",
      "description": "Insufficient votes (2/4 nodes, should FAIL)",
      "operation": "register_key",
      "active_nodes": 2,
      "expected_result": "failure"
    },
    {
      "test_id": "TC-005",
      "description": "Key versioning (should PASS)",
      "operation": "update_key",
      "expected_result": "success",
      "expected_version": 2
    },
    {
      "test_id": "TC-006",
      "description": "Conflict resolution (should PASS)",
      "operation": "concurrent_update",
      "expected_result": "success",
      "expected_resolution": "last_write_wins"
    }
  ],
  "expected_results": {
    "registration_ms": 100,
    "discovery_ms": 10,
    "sync_ms": 50,
    "conflict_resolution_ms": 20,
    "test_cases_passed": 5,
    "consensus_success_rate": 100
  }
}

