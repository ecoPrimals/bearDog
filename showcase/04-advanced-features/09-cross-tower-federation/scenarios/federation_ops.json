{
  "scenario_name": "Cross-Tower Federation Operations",
  "scenario_id": "federation-001",
  "operation": "federated_operations",
  "towers": [
    {
      "id": "tower-us",
      "name": "US Tower",
      "region": "us",
      "capabilities": ["key-management", "storage", "compute"]
    },
    {
      "id": "tower-eu",
      "name": "EU Tower",
      "region": "eu",
      "capabilities": ["key-management", "storage", "gdpr-compliance"]
    },
    {
      "id": "tower-apac",
      "name": "APAC Tower",
      "region": "apac",
      "capabilities": ["key-management", "storage"]
    }
  ],
  "operations": [
    {
      "op_id": "OP-001",
      "operation": "key_rotation",
      "description": "Global master key rotation",
      "initiator": "tower-us",
      "requires_consensus": true
    },
    {
      "op_id": "OP-002",
      "operation": "data_storage",
      "description": "Store EU citizen data",
      "initiator": "tower-eu",
      "region_constraint": "eu"
    },
    {
      "op_id": "OP-003",
      "operation": "capability_discovery",
      "description": "Discover all tower capabilities",
      "initiator": "tower-us",
      "requires_consensus": false
    }
  ],
  "test_cases": [
    {
      "test_id": "TC-001",
      "description": "Tower discovery (should PASS)",
      "test_type": "discovery",
      "expected_result": "success",
      "expected_towers": 3
    },
    {
      "test_id": "TC-002",
      "description": "Trust establishment (should PASS)",
      "test_type": "trust",
      "expected_result": "success"
    },
    {
      "test_id": "TC-003",
      "description": "Global key rotation with consensus (should PASS)",
      "operation": "OP-001",
      "test_type": "consensus",
      "expected_result": "success",
      "expected_votes": 3
    },
    {
      "test_id": "TC-004",
      "description": "Sovereignty enforcement (should PASS)",
      "operation": "OP-002",
      "test_type": "sovereignty",
      "expected_result": "success",
      "expected_region": "eu"
    },
    {
      "test_id": "TC-005",
      "description": "Cross-tower capability discovery (should PASS)",
      "operation": "OP-003",
      "test_type": "capabilities",
      "expected_result": "success"
    },
    {
      "test_id": "TC-006",
      "description": "Federated audit trail (should PASS)",
      "test_type": "audit",
      "expected_result": "success"
    }
  ],
  "expected_results": {
    "discovery_ms": 100,
    "trust_establishment_ms": 200,
    "consensus_ms": 500,
    "operation_ms": 1000,
    "test_cases_passed": 6
  }
}

