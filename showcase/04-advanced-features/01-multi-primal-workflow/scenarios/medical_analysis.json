{
  "scenario_name": "Medical Records Analysis",
  "scenario_id": "med-001",
  "user_id": "dr.alice@hospital.example.com",
  "operation": "analyze_and_store_encrypted",
  "data": {
    "content": "Patient medical records for analysis. Contains sensitive health information including diagnosis, treatment history, and lab results.",
    "metadata": {
      "patient_id": "PATIENT-12345",
      "date": "2025-12-26",
      "department": "Cardiology",
      "classification": "highly_sensitive"
    }
