    {
      "step": 2,
      "service": "ai",
      "operation": "analyze",
      "description": "Analyze medical records with PII sanitization"
    },
    {
      "step": 3,
      "service": "storage",
      "operation": "store_encrypted",
      "description": "Store encrypted analysis results"
    },
    {
      "step": 4,
      "service": "compute",
      "operation": "process_encrypted",
      "description": "Perform statistical analysis on encrypted data"
    },
    {
      "step": 5,
      "service": "orchestration",
      "operation": "coordinate",
      "description": "Coordinate multi-node operations"
    },
    {
      "step": 6,
      "service": "beardog",
      "operation": "verify_and_audit",
      "description": "Verify lineage and generate audit receipt"
    }
  ],
  "expected_results": {
    "total_duration_ms": 450,
    "services_contacted": 4,
    "lineage_tracked": true,
    "audit_generated": true,
    "compliance_validated": true
  }
