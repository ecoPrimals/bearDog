{
  "scenario_name": "Corporate Treasury Authorization",
  "scenario_id": "corp-treasury-001",
  "operation": "authorize_wire_transfer",
  "amount": "$10,000,000",
  "destination": "Acquisition Escrow Account",
  "requester": "CFO",
  "approval_policy": {
    "threshold": 3,
    "total_shares": 5,
    "share_holders": [
      {
        "id": "SH-001",
        "name": "CEO",
        "title": "Chief Executive Officer",
        "authorization_level": "executive"
      },
      {
        "id": "SH-002",
        "name": "CFO",
        "title": "Chief Financial Officer",
        "authorization_level": "executive"
      },
      {
        "id": "SH-003",
        "name": "CTO",
        "title": "Chief Technology Officer",
        "authorization_level": "executive"
      },
      {
        "id": "SH-004",
        "name": "COO",
        "title": "Chief Operating Officer",
        "authorization_level": "executive"
      },
      {
        "id": "SH-005",
        "name": "Board-Member",
        "title": "Board of Directors Representative",
        "authorization_level": "board"
      }
    ]
  },
  "test_cases": [
    {
      "test_id": "TC-001",
      "description": "Insufficient shares (2-of-5, should FAIL)",
      "shares_provided": ["SH-001", "SH-002"],
      "expected_result": "failure",
      "expected_error": "InsufficientShares"
    },
    {
      "test_id": "TC-002",
      "description": "Exact threshold (3-of-5, should SUCCEED)",
      "shares_provided": ["SH-001", "SH-002", "SH-003"],
      "expected_result": "success"
    },
    {
      "test_id": "TC-003",
      "description": "Excess shares (4-of-5, should SUCCEED)",
      "shares_provided": ["SH-001", "SH-002", "SH-003", "SH-004"],
      "expected_result": "success"
    },
    {
      "test_id": "TC-004",
      "description": "All shares (5-of-5, should SUCCEED)",
      "shares_provided": ["SH-001", "SH-002", "SH-003", "SH-004", "SH-005"],
      "expected_result": "success"
    },
    {
      "test_id": "TC-005",
      "description": "Different combination (3-of-5, should SUCCEED)",
      "shares_provided": ["SH-002", "SH-004", "SH-005"],
      "expected_result": "success"
    }
  ],
  "expected_results": {
    "share_generation_ms": 50,
    "key_reconstruction_ms": 100,
    "total_ceremony_ms": 500,
    "test_cases_passed": 5,
    "audit_trail_complete": true
  }
}

