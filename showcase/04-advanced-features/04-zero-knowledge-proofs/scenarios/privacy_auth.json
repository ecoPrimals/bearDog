{
  "scenario_name": "Privacy-Preserving Authentication",
  "scenario_id": "zkp-auth-001",
  "operation": "zero_knowledge_authentication",
  "proof_requests": [
    {
      "proof_id": "PR-001",
      "proof_type": "key_ownership",
      "description": "Prove ownership of private key without revealing it",
      "prover": "Alice",
      "verifier": "BearDog Service",
      "data": {
        "statement": "I own the private key corresponding to public key X"
      }
    },
    {
      "proof_id": "PR-002",
      "proof_type": "age_verification",
      "description": "Prove age > 21 without revealing birthdate",
      "prover": "Bob",
      "verifier": "Age-Restricted Service",
      "data": {
        "statement": "My age is greater than 21",
        "actual_age": 25,
        "minimum_age": 21
      }
    },
    {
      "proof_id": "PR-003",
      "proof_type": "set_membership",
      "description": "Prove membership in authorized set without revealing identity",
      "prover": "Carol",
      "verifier": "Access Control System",
      "data": {
        "statement": "I am in the authorized user set",
        "set_size": 100
      }
    }
  ],
  "test_cases": [
    {
      "test_id": "TC-001",
      "description": "Valid key ownership proof (should PASS)",
      "proof_id": "PR-001",
      "expected_result": "success"
    },
    {
      "test_id": "TC-002",
      "description": "Valid age verification (age 25 > 21, should PASS)",
      "proof_id": "PR-002",
      "expected_result": "success"
    },
    {
      "test_id": "TC-003",
      "description": "Invalid key ownership (wrong key, should FAIL)",
      "proof_id": "PR-001",
      "tamper": "use_wrong_key",
      "expected_result": "failure"
    },
    {
      "test_id": "TC-004",
      "description": "Invalid age (underage, should FAIL)",
      "proof_id": "PR-002",
      "tamper": "underage",
      "expected_result": "failure"
    },
    {
      "test_id": "TC-005",
      "description": "Valid set membership proof (should PASS)",
      "proof_id": "PR-003",
      "expected_result": "success"
    }
  ],
  "expected_results": {
    "commitment_ms": 10,
    "challenge_response_ms": 20,
    "verification_ms": 10,
    "total_proof_ms": 50,
    "test_cases_passed": 3
  }
}

