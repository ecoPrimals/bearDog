# BearDog Development Environment Configuration
# NOTE: HTTP/REST vars below are from the pre-UniBin era. Primary transport
# is now Unix socket JSON-RPC. See docs/references/ENVIRONMENT_VARIABLES.md.
# Source this file: source configs/environments/development.env

# Application settings
export BEARDOG_APP_NAME="BearDog-Development"
export BEARDOG_ENVIRONMENT="development"
export BEARDOG_DEBUG="true"
export BEARDOG_STANDALONE_MODE="true"

# Network settings - development optimized
export BEARDOG_HTTP_BIND="127.0.0.1:8080"
export BEARDOG_HTTPS_ENABLED="false"
export BEARDOG_RATE_LIMIT_RPM="10000"
export BEARDOG_RATE_LIMIT_BURST="1000"
export BEARDOG_CORS_ORIGINS="http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000"
export BEARDOG_CORS_HEADERS="*"

# Security settings - relaxed for development
export BEARDOG_SECURITY_LEVEL="Standard"
export BEARDOG_HSM_ENABLED="false"
export BEARDOG_TOKEN_EXPIRATION="28800"  # 8 hours
export BEARDOG_MAX_FAILED_LOGINS="10"
export BEARDOG_PASSWORD_MIN_LENGTH="8"
export BEARDOG_PASSWORD_REQUIRE_UPPERCASE="false"
export BEARDOG_PASSWORD_REQUIRE_LOWERCASE="false"
export BEARDOG_PASSWORD_REQUIRE_NUMBERS="false"
export BEARDOG_PASSWORD_REQUIRE_SPECIAL="false"
export BEARDOG_MFA_REQUIRED="false"
export BEARDOG_SESSION_TIMEOUT="8h"
export BEARDOG_SECURE_COOKIES="false"

# Storage settings - simplified for development
export BEARDOG_STORAGE_DISCOVERY="local"
export BEARDOG_STORAGE_FALLBACK="memory"
export BEARDOG_STORAGE_CAPABILITIES="database_operations,secure_storage,audit_logging"
export BEARDOG_SECURITY_RETENTION_DAYS="7"
export BEARDOG_AUDIT_RETENTION_DAYS="7"
export BEARDOG_SESSION_RETENTION_DAYS="1"
export BEARDOG_WORKFLOW_RETENTION_DAYS="3"
export BEARDOG_ZFS_ENCRYPTION="false"
export BEARDOG_ZFS_SNAPSHOTS="false"

# Performance settings - development optimized
export BEARDOG_REQUEST_TIMEOUT="60"
export BEARDOG_CONNECT_TIMEOUT="30"
export BEARDOG_READ_TIMEOUT="60"
export BEARDOG_WRITE_TIMEOUT="60"

# Feature flags - development
export BEARDOG_FEATURE_GENETIC="false"
export BEARDOG_FEATURE_DISTRIBUTED="false" 