# BearDog Node Registry Configuration
# Environment variables for production deployment
# Copy this file to production.env and customize values

# ============================================================================
# P2P Network Configuration
# ============================================================================

# P2P listen address (default: 0.0.0.0)
# BEARDOG_P2P_LISTEN_ADDRESS=0.0.0.0

# P2P listen port (default: 8081)
# BEARDOG_P2P_LISTEN_PORT=8081

# Maximum number of peers (default: 50)
# BEARDOG_P2P_MAX_PEERS=50

# ============================================================================
# Bootstrap Node Configuration
# ============================================================================

# Bootstrap node ID (default: default_node)
# BEARDOG_BOOTSTRAP_NODE_ID=production-bootstrap-01

# Bootstrap node address (default: from NetworkConfig)
# BEARDOG_BOOTSTRAP_ADDRESS=bootstrap.beardog.network

# Bootstrap node port (default: from NetworkConfig)
# BEARDOG_BOOTSTRAP_PORT=8443

# Bootstrap network address (full address:port, default: from NetworkConfig)
# BEARDOG_BOOTSTRAP_NETWORK_ADDRESS=bootstrap.beardog.network:8443

# ============================================================================
# Registry Configuration
# ============================================================================

# Registry ID (default: beardog-registry)
# BEARDOG_REGISTRY_ID=production-registry-01

# Registry name (default: BearDog Node Registry)
# BEARDOG_REGISTRY_NAME=Production BearDog Registry

# Registry version (default: 1.0.0)
# BEARDOG_REGISTRY_VERSION=1.0.0

# Registry bind address (default: 0.0.0.0)
# BEARDOG_REGISTRY_BIND_ADDRESS=0.0.0.0

# Registry port (default: 8080)
# BEARDOG_REGISTRY_PORT=8080

# Maximum nodes (default: 10000)
# BEARDOG_REGISTRY_MAX_NODES=50000

# ============================================================================
# Example Production Configuration
# ============================================================================

# Uncomment and customize for production deployment:
#
# P2P Network
# BEARDOG_P2P_LISTEN_ADDRESS=10.0.1.100
# BEARDOG_P2P_LISTEN_PORT=30001
# BEARDOG_P2P_MAX_PEERS=100
#
# Bootstrap Node
# BEARDOG_BOOTSTRAP_NODE_ID=prod-bootstrap-us-east-1
# BEARDOG_BOOTSTRAP_ADDRESS=10.0.1.10
# BEARDOG_BOOTSTRAP_PORT=8443
# BEARDOG_BOOTSTRAP_NETWORK_ADDRESS=bootstrap.prod.beardog.network:8443
#
# Registry
# BEARDOG_REGISTRY_ID=prod-registry-us-east-1
# BEARDOG_REGISTRY_NAME=Production Registry US-East
# BEARDOG_REGISTRY_VERSION=1.2.3
# BEARDOG_REGISTRY_BIND_ADDRESS=0.0.0.0
# BEARDOG_REGISTRY_PORT=8443
# BEARDOG_REGISTRY_MAX_NODES=100000

# ============================================================================
# Security Notes
# ============================================================================
#
# 1. Never commit actual production values to version control
# 2. Use secrets management for sensitive configuration
# 3. Rotate credentials regularly
# 4. Use TLS for production endpoints
# 5. Restrict bind addresses to specific interfaces in production
#
# ============================================================================

