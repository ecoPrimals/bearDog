# BearDog Network Discovery Configuration Template
# 
# NOTE: Many HTTP/REST vars below predate the Unix socket JSON-RPC transport.
# See docs/references/ENVIRONMENT_VARIABLES.md for current vars.
#
# This template eliminates hardcoded network endpoints by providing
# environment-based configuration for all network resources.
#
# Copy this file to .env and customize for your environment.

# =============================================================================
# CORE NETWORK CONFIGURATION
# =============================================================================

# Default host for all services (replaces hardcoded localhost)
BEARDOG_DEFAULT_HOST=localhost
BEARDOG_DEFAULT_PROTOCOL=http

# Enable localhost fallback for development
BEARDOG_ENABLE_LOCALHOST_FALLBACK=true

# =============================================================================
# SERVICE DISCOVERY ENDPOINTS
# =============================================================================

# Compute Service Configuration
BEARDOG_COMPUTE_ENDPOINT=http://compute.local:8080
BEARDOG_COMPUTE_PORT=8080
BEARDOG_COMPUTE_HEALTH_PORT=8081
BEARDOG_COMPUTE_METRICS_PORT=9190
BEARDOG_COMPUTE_ADMIN_PORT=8082
BEARDOG_COMPUTE_HEALTH_ENDPOINT=http://compute.local:8081/health
BEARDOG_COMPUTE_METRICS_ENDPOINT=http://compute.local:9190/metrics
BEARDOG_COMPUTE_BACKUPS=http://compute-backup1.local:8080,http://compute-backup2.local:8080

# Storage Service Configuration  
BEARDOG_STORAGE_ENDPOINT=http://storage.local:8084
BEARDOG_STORAGE_PORT=8084
BEARDOG_STORAGE_HEALTH_PORT=8085
BEARDOG_STORAGE_METRICS_PORT=9091
BEARDOG_STORAGE_ADMIN_PORT=8086
BEARDOG_STORAGE_HEALTH_ENDPOINT=http://storage.local:8085/health
BEARDOG_STORAGE_METRICS_ENDPOINT=http://storage.local:9091/metrics
BEARDOG_STORAGE_BACKUPS=http://storage-backup1.local:8084,http://storage-backup2.local:8084

# AI/Intelligence Service Configuration
BEARDOG_AI_ENDPOINT=http://ai.local:8083
BEARDOG_AI_PORT=8083
BEARDOG_AI_HEALTH_PORT=8087
BEARDOG_AI_METRICS_PORT=9092
BEARDOG_AI_ADMIN_PORT=8088
BEARDOG_AI_HEALTH_ENDPOINT=http://ai.local:8087/health
BEARDOG_AI_METRICS_ENDPOINT=http://ai.local:9092/metrics
BEARDOG_AI_BACKUPS=http://ai-backup1.local:8083,http://ai-backup2.local:8083

# Service Mesh Configuration
BEARDOG_MESH_ENDPOINT=http://mesh.local:8082
BEARDOG_MESH_PORT=8082
BEARDOG_MESH_HEALTH_PORT=8089
BEARDOG_MESH_METRICS_PORT=9093
BEARDOG_MESH_ADMIN_PORT=8090
BEARDOG_MESH_HEALTH_ENDPOINT=http://mesh.local:8089/health
BEARDOG_MESH_METRICS_ENDPOINT=http://mesh.local:9093/metrics
BEARDOG_MESH_BACKUPS=http://mesh-backup1.local:8082,http://mesh-backup2.local:8082

# Discovery Service Configuration
BEARDOG_DISCOVERY_ENDPOINT=http://discovery.local:8081
BEARDOG_DISCOVERY_PORT=8081
BEARDOG_DISCOVERY_HEALTH_PORT=8091
BEARDOG_DISCOVERY_METRICS_PORT=9094
BEARDOG_DISCOVERY_ADMIN_PORT=8092
BEARDOG_DISCOVERY_HEALTH_ENDPOINT=http://discovery.local:8091/health
BEARDOG_DISCOVERY_METRICS_ENDPOINT=http://discovery.local:9094/metrics
BEARDOG_DISCOVERY_BACKUPS=http://discovery-backup1.local:8081,http://discovery-backup2.local:8081

# =============================================================================
# BEARDOG API CONFIGURATION
# =============================================================================

# Main BearDog service ports (replaces hardcoded 8080, 8081, etc.)
BEARDOG_API_PORT=8080
BEARDOG_ADMIN_PORT=8081
BEARDOG_METRICS_PORT=9190
BEARDOG_WS_PORT=8082
BEARDOG_HEALTH_PORT=8083

# BearDog service endpoints
BEARDOG_CAPABILITIES_URL=http://localhost:8080/api/v1/capabilities
BEARDOG_HEALTH_URL=http://localhost:8083/health
BEARDOG_METRICS_URL=http://localhost:9190/metrics
BEARDOG_ADMIN_URL=http://localhost:8081/admin
BEARDOG_WEBSOCKET_URL=ws://localhost:8082/ws

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Database connection (replaces hardcoded database URLs)
DATABASE_URL=postgresql://beardog:password@localhost:5432/beardog
BEARDOG_DATABASE_URL=postgresql://beardog:password@localhost:5432/beardog

# Database connection pool settings
DB_MAX_CONNECTIONS=10
DB_MIN_CONNECTIONS=1
DB_CONNECTION_TIMEOUT=30
DB_IDLE_TIMEOUT=600

# Database SSL configuration
DB_SSL_ENABLED=false
DB_SSL_MODE=prefer
# DB_SSL_CERT=/path/to/client.crt
# DB_SSL_KEY=/path/to/client.key

# =============================================================================
# NETWORK TIMEOUTS AND POLICIES
# =============================================================================

# Request timeouts (milliseconds)
BEARDOG_REQUEST_TIMEOUT_MS=30000
BEARDOG_CONNECTION_TIMEOUT_MS=5000
BEARDOG_KEEPALIVE_TIMEOUT_S=60

# =============================================================================
# TLS AND SECURITY CONFIGURATION
# =============================================================================

# TLS settings
BEARDOG_TLS_ENABLED=true
BEARDOG_VERIFY_CERTS=true

# Certificate paths
# BEARDOG_CA_CERT=/path/to/ca.crt
# BEARDOG_CLIENT_CERT=/path/to/client.crt
# BEARDOG_CLIENT_KEY=/path/to/client.key

# =============================================================================
# ENVIRONMENT-SPECIFIC OVERRIDES
# =============================================================================

# Development Environment
# BEARDOG_DEFAULT_HOST=localhost
# BEARDOG_ENABLE_LOCALHOST_FALLBACK=true
# BEARDOG_TLS_ENABLED=false

# Production Environment
# BEARDOG_DEFAULT_HOST=0.0.0.0
# BEARDOG_ENABLE_LOCALHOST_FALLBACK=false
# BEARDOG_TLS_ENABLED=true
# BEARDOG_VERIFY_CERTS=true

# Kubernetes Environment
# BEARDOG_COMPUTE_ENDPOINT=http://compute-service.beardog.svc.cluster.local:8080
# BEARDOG_STORAGE_ENDPOINT=http://storage-service.beardog.svc.cluster.local:8084
# BEARDOG_AI_ENDPOINT=http://ai-service.beardog.svc.cluster.local:8083
# BEARDOG_MESH_ENDPOINT=http://mesh-service.beardog.svc.cluster.local:8082
# BEARDOG_DISCOVERY_ENDPOINT=http://discovery-service.beardog.svc.cluster.local:8081

# =============================================================================
# TESTING CONFIGURATION
# =============================================================================

# Test environment settings
TEST_LOCALHOST=127.0.0.1
TEST_ENDPOINT_BASE=http://localhost
TEST_API_PORT=8080

# =============================================================================
# MIGRATION NOTES
# =============================================================================

# This configuration eliminates the following hardcoded values:
#
# BEFORE (Hardcoded):
# - "localhost" -> BEARDOG_DEFAULT_HOST
# - "127.0.0.1" -> TEST_LOCALHOST
# - "0.0.0.0" -> BEARDOG_DEFAULT_HOST (production)
# - ":8080" -> BEARDOG_API_PORT
# - ":3000" -> Custom port via environment
# - ":5432" -> DATABASE_URL port
# - "http://compute.local:8080" -> BEARDOG_COMPUTE_ENDPOINT
# - "http://storage.local:8080" -> BEARDOG_STORAGE_ENDPOINT
#
# AFTER (Configurable):
# - All network endpoints configurable via environment variables
# - Fallback values provided for development
# - Production-ready defaults available
# - Backup endpoints supported for high availability
# - Health check and metrics endpoints configurable
# - SSL/TLS configuration externalized
# - Database connection fully configurable

# =============================================================================
# USAGE EXAMPLES
# =============================================================================

# 1. Development (default values):
# No environment variables needed - uses localhost fallbacks

# 2. Production deployment:
# Set production endpoints:
# export BEARDOG_COMPUTE_ENDPOINT="https://compute.production.com:443"
# export BEARDOG_STORAGE_ENDPOINT="https://storage.production.com:443"
# export BEARDOG_TLS_ENABLED=true

# 3. Docker Compose:
# Use service names:
# export BEARDOG_COMPUTE_ENDPOINT="http://compute:8080"
# export BEARDOG_STORAGE_ENDPOINT="http://storage:8084"

# 4. Kubernetes:
# Use service DNS:
# export BEARDOG_COMPUTE_ENDPOINT="http://compute-service:8080"
# export BEARDOG_STORAGE_ENDPOINT="http://storage-service:8084" 