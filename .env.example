# BearDog Environment Configuration Template
# Copy to .env.production and fill in real values
BEARDOG_ADMIN_PASSWORD=CHANGE_ME
BEARDOG_API_BIND_ADDRESS=0.0.0.0:8080
BEARDOG_LOG_LEVEL=info
BEARDOG_ENVIRONMENT=production
BEARDOG_HSM_MODE=software
BEARDOG_ENABLE_METRICS=true
BEARDOG_ENABLE_TRACING=true
BEARDOG_MAX_CONNECTIONS=10000
BEARDOG_REQUEST_TIMEOUT=30
BEARDOG_ENABLE_CORS=false
BEARDOG_TLS_ENABLED=true
