# BearDog Environment Configuration Template
# Copy to .env.production and fill in real values.
# BearDog serves JSON-RPC 2.0 over NDJSON via Unix sockets (or TCP/named pipes).

BEARDOG_LOG_LEVEL=info
BEARDOG_ENVIRONMENT=production
BEARDOG_HSM_MODE=software
BEARDOG_METRICS_ENABLED=true
BEARDOG_REQUEST_TIMEOUT_SECS=30
