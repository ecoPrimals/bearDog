# BearDog Development Environment Configuration
# Source this file with: source configs/environments/development.env

# Core BearDog Configuration
export BEARDOG_HOST="127.0.0.1"
export BEARDOG_API_PORT="8080"
export BEARDOG_HEALTH_PORT="8081"
export BEARDOG_METRICS_PORT="9090"
export BEARDOG_ADMIN_PORT="8082"
export BEARDOG_WS_PORT="8080"

# Service Mesh Configuration
export SERVICE_MESH_ENDPOINT="http://127.0.0.1:8080/api/v1/capabilities"
export SERVICE_MESH_HEALTH_ENDPOINT="http://127.0.0.1:8081/health"
export SERVICE_MESH_METRICS_ENDPOINT="http://127.0.0.1:9090/metrics"
export SERVICE_MESH_ADMIN_ENDPOINT="http://127.0.0.1:8082/admin"
export SERVICE_MESH_WS_ENDPOINT="ws://127.0.0.1:8080/ws"

# External Service Configuration
export VAULT_ADDR="http://127.0.0.1:8200"

# Discovery Configuration
export BEARDOG_DISCOVERY_ENDPOINT="http://127.0.0.1:8080/discovery"
export BEARDOG_COMPUTE_ENDPOINT="http://127.0.0.1:8081"
export BEARDOG_MESH_ENDPOINT="http://127.0.0.1:8082"
export BEARDOG_AI_ENDPOINT="http://127.0.0.1:8083"
export BEARDOG_STORAGE_ENDPOINT="http://127.0.0.1:8084"

# Production Endpoints (for testing)
export BEARDOG_PUBLIC_ENDPOINT="https://dev.beardog.local"
export SONGBIRD_ENDPOINT="https://songbird.dev.local"

# Test Configuration
export TEST_LOCALHOST="127.0.0.1"
export TEST_ENDPOINT_BASE="http://127.0.0.1"

echo "✅ BearDog development environment configured"
echo "   🏠 Host: $BEARDOG_HOST"
echo "   🔌 API Port: $BEARDOG_API_PORT"
echo "   📊 Metrics Port: $BEARDOG_METRICS_PORT"
echo "   🔒 Vault: $VAULT_ADDR" 