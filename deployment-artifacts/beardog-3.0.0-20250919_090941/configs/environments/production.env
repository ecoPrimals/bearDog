# BearDog Production Environment Configuration
# Source this file: source configs/environments/production.env
# Ensure all secrets are properly set in your deployment environment

# Application settings
export BEARDOG_APP_NAME="BearDog-Production"
export BEARDOG_ENVIRONMENT="production"
export BEARDOG_DEBUG="false"
export BEARDOG_STANDALONE_MODE="false"

# Network settings - production hardened
export BEARDOG_HTTP_BIND="0.0.0.0:8080"
export BEARDOG_HTTPS_ENABLED="true"
export BEARDOG_HTTPS_BIND="0.0.0.0:8443"
export BEARDOG_RATE_LIMIT_RPM="1000"
export BEARDOG_RATE_LIMIT_BURST="100"
export BEARDOG_CORS_ORIGINS="https://dashboard.production.company.com"
export BEARDOG_CORS_METHODS="GET,POST,PUT,DELETE"
export BEARDOG_CORS_HEADERS="Authorization,Content-Type,X-API-Key"

# SSL Certificate paths (customize for your environment)
export BEARDOG_CERT_PATH="/etc/ssl/certs/beardog-api.crt"
export BEARDOG_KEY_PATH="/etc/ssl/private/beardog-api.key"
export BEARDOG_CERT_CHAIN_PATH="/etc/ssl/certs/beardog-chain.crt"
export BEARDOG_CLIENT_CERT_VERIFICATION="true"

# Security settings - production hardened
export BEARDOG_SECURITY_LEVEL="High"
export BEARDOG_HSM_ENABLED="true"
export BEARDOG_TOKEN_EXPIRATION="3600"  # 1 hour
export BEARDOG_MAX_FAILED_LOGINS="3"
export BEARDOG_PASSWORD_MIN_LENGTH="16"
export BEARDOG_PASSWORD_REQUIRE_UPPERCASE="true"
export BEARDOG_PASSWORD_REQUIRE_LOWERCASE="true"
export BEARDOG_PASSWORD_REQUIRE_NUMBERS="true"
export BEARDOG_PASSWORD_REQUIRE_SPECIAL="true"
export BEARDOG_PASSWORD_HISTORY="12"
export BEARDOG_PASSWORD_MAX_AGE="30d"
export BEARDOG_MFA_REQUIRED="true"
export BEARDOG_MFA_METHODS="TOTP,WebAuthn"
export BEARDOG_SESSION_TIMEOUT="1h"
export BEARDOG_SESSION_CLEANUP="5m"
export BEARDOG_SECURE_COOKIES="true"

# HSM settings - production (customize for your HSM)
export BEARDOG_HSM_PROVIDER="PKCS11"
# export BEARDOG_HSM_PIN="<SET_IN_SECURE_ENVIRONMENT>"
# export BEARDOG_HSM_LIBRARY_PATH="/path/to/your/hsm/library.so"

# Storage settings - production with compliance
export BEARDOG_STORAGE_DISCOVERY="songbird"
export BEARDOG_STORAGE_FALLBACK="local"
export BEARDOG_STORAGE_CAPABILITIES="database_operations,zfs_storage,audit_logging,policy_enforcement,encryption_at_rest,snapshot_management"
export BEARDOG_SECURITY_RETENTION_DAYS="2555"  # 7 years
export BEARDOG_AUDIT_RETENTION_DAYS="2555"     # 7 years
export BEARDOG_SESSION_RETENTION_DAYS="30"
export BEARDOG_WORKFLOW_RETENTION_DAYS="365"
export BEARDOG_SECURITY_ARCHIVE="true"
export BEARDOG_AUDIT_ARCHIVE="true"
export BEARDOG_WORKFLOW_ARCHIVE="true"
export BEARDOG_SECURITY_COMPLIANCE="SOX,GDPR"
export BEARDOG_AUDIT_COMPLIANCE="SOX,HIPAA"
export BEARDOG_WORKFLOW_COMPLIANCE="SOX"

# ZFS settings - production
export BEARDOG_ZFS_ENCRYPTION="true"
export BEARDOG_ZFS_COMPRESSION="true"
export BEARDOG_ZFS_SNAPSHOTS="true"
export BEARDOG_ZFS_SNAPSHOT_FREQUENCY="24"
export BEARDOG_ZFS_SNAPSHOT_RETENTION="30"

# Performance settings - production optimized
export BEARDOG_REQUEST_TIMEOUT="30"
export BEARDOG_CONNECT_TIMEOUT="10"
export BEARDOG_READ_TIMEOUT="30"
export BEARDOG_WRITE_TIMEOUT="30"
export BEARDOG_PERF_MAX_CONNECTIONS="100"
export BEARDOG_WORKER_THREADS="8"
export BEARDOG_QUEUE_SIZE="2000"

# External services - production endpoints
export BEARDOG_SONGBIRD_ENDPOINT="https://songbird.production.company.com:8443"
export BEARDOG_NESTGATE_ENDPOINT="https://nestgate.production.company.com:8443"
export BEARDOG_SQUIRREL_ENDPOINT="https://squirrel.production.company.com:8443"
export BEARDOG_TOADSTOOL_ENDPOINT="https://toadstool.production.company.com:8443"
export BEARDOG_BIOMEOS_ENDPOINT="https://biomeos.production.company.com:8443"

# SMTP settings - production
# export BEARDOG_SMTP_SERVER="<YOUR_SMTP_SERVER>"
# export BEARDOG_SMTP_PORT="587"

# Feature flags - production
export BEARDOG_FEATURE_GENETIC="true"
export BEARDOG_FEATURE_THREAT_DETECTION="true"
export BEARDOG_FEATURE_MONITORING="true"
export BEARDOG_FEATURE_CACHING="true"
export BEARDOG_FEATURE_DISTRIBUTED="true"

# Monitoring and alerting
export BEARDOG_HEALTH_CHECK_INTERVAL="30"
export BEARDOG_METRICS_INTERVAL="60"
export BEARDOG_FAILURE_THRESHOLD="3"
export BEARDOG_RECOVERY_THRESHOLD="2" 