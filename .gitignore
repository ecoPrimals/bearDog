# BearDog Unified Rust Ecosystem - .gitignore
# Version: 3.0.0 - Canonical Modernization Complete

# ============================================================================
# RUST BUILD ARTIFACTS
# ============================================================================

# Primary build artifacts
**/target/
**/*.rs.bk
*.pdb

# Cargo lock files (keep root, ignore in subdirectories)
Cargo.lock  # Keep root Cargo.lock for reproducible builds
**/Cargo.lock

# Rust compilation artifacts
**/.fingerprint/
**/incremental/
**/*.rlib
**/*.rmeta
**/*.so
**/*.dylib
**/*.dll
**/*.d
**/*.o

# ============================================================================
# IDE AND EDITOR FILES
# ============================================================================

# VSCode
.vscode/
!.vscode/settings.json
!.vscode/tasks.json  
!.vscode/launch.json
!.vscode/extensions.json

# IntelliJ/CLion
.idea/
*.iml
*.iws
*.ipr

# Vim/Neovim
*.swp
*.swo
*~
.vim/
.nvim/

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

# ============================================================================
# OPERATING SYSTEM FILES
# ============================================================================

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
ehthumbs.db
Thumbs.db
desktop.ini

# Linux
*~
.nfs*

# ============================================================================
# CONFIGURATION AND ENVIRONMENT
# ============================================================================

# Environment files
.env
.env.*
.envrc

# Legacy configuration files (replaced by unified system)
config.toml
beardog-config.toml
*-config.toml
!configs/beardog-config-template.toml  # Keep our unified template

# Unified configuration system (keep templates, ignore instances)
!configs/
!configs/*.toml
!configs/environments/*.env
configs/environments/local.env  # Ignore local overrides
configs/environments/personal.env

# Runtime configuration instances
runtime-config.toml
local-config.toml

# ============================================================================
# LOGS AND TEMPORARY FILES
# ============================================================================

# Log files (archived to parent)
*.log
*.log.*
*.txt.log
logs/
!logs/.gitkeep

# Temporary files
*.tmp
*.temp
*.cache
.cache/

# Modernization temporary files (cleanup artifacts)
*_TEMP.md
*_BACKUP.md
TEMP_*.md
CLEANUP_*.md

# Old quick scripts (archived to parent)
QUICK_*.sh
VERIFY_*.sh
deploy-to-*.sh

# ============================================================================
# SECURITY SENSITIVE FILES
# ============================================================================

# Cryptographic keys and certificates
*.key
*.pem
*.p12
*.pfx
*.crt
*.csr
private_keys/
certificates/
keys/

# Security configuration
secrets.json
secrets.toml
*.secret
hsm-config.json

# Authentication tokens
.token
*.jwt
auth_tokens/

# ============================================================================
# DATABASE AND STORAGE
# ============================================================================

# Database files
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# Storage artifacts
storage/
data/
!data/.gitkeep

# ============================================================================
# BUILD AND DISTRIBUTION
# ============================================================================

# Build directories
/dist/
/build/
**/build/
/book/
/pkg/

# Distribution artifacts
*.tar.gz
*.zip
*.deb
*.rpm
*.dmg
*.msi

# ============================================================================
# TESTING AND COVERAGE
# ============================================================================

# Test coverage reports (archived to parent)
tarpaulin-report.html
tarpaulin-report.json
cobertura.xml
lcov.info
coverage/
coverage-*/
coverage*.json
*.profraw
*.profdata
test-results/
junit.xml

# Test artifacts
test-output/
.test_artifacts/

# ============================================================================
# BENCHMARKING AND PROFILING
# ============================================================================

# Criterion benchmarks
criterion/
benchmark_results*/
target/criterion/

# Profiling artifacts
flamegraph.svg
perf.data*
*.prof
callgrind.out.*

# ============================================================================
# DOCUMENTATION BUILD ARTIFACTS
# ============================================================================

# Generated documentation
/target/doc/
docs/_build/
docs/site/
_site/

# Documentation temporary files
docs/**/*_temp.md
docs/**/*.backup

# ============================================================================
# PACKAGE MANAGERS AND DEPENDENCIES
# ============================================================================

# Node.js (for documentation tooling)
node_modules/
package-lock.json
yarn.lock
.npm/
.yarn/

# Python (for automation scripts)
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.egg-info/
venv/
.venv/

# ============================================================================
# DEVELOPMENT TOOLS
# ============================================================================

# Rust development
.cargo/
.rustup/
rust-project.json
rust-analyzer.json

# Git hooks and local tools
.git/hooks/local-*
.githooks/

# ============================================================================
# DEPLOYMENT AND CONTAINERIZATION
# ============================================================================

# Docker
.dockerignore
docker-compose.override.yml
.docker/

# Kubernetes
k8s-secrets.yml
*.k8s.local.yml

# Deployment artifacts
deployment-output/
.deploy/

# ============================================================================
# MOBILE AND PLATFORM SPECIFIC
# ============================================================================

# Android
*.apk
*.aab
local.properties
android/app/release/

# iOS
*.ipa
ios/build/

# ============================================================================
# ARCHIVE AND LEGACY
# ============================================================================

# Archive directories (moved to parent ../archive/)
archive/
!archive/.gitkeep
# EXCEPT: docs/archive is for documentation archives (not build artifacts)
!docs/archive/

# Backup files
*.bak
*.backup
*.old
*.orig
*_backup
*~

# Legacy migration artifacts
migration_*.json
legacy_*.toml

# Old session marker files
*_CERTIFICATE_*.txt
*_REPORT_CARD_*.txt
*_READY_TO_DEPLOY_*.txt
ROOT_DOCS_UPDATED_*.txt

# ============================================================================
# GENERATED AND PROCESSED FILES
# ============================================================================

# Code generation
**/*_generated.rs
**/*.generated.*
**/gen/

# Processed documentation
**/*.processed.md
**/*.compiled.md

# Build metadata
build_info.json
version_info.rs

# ============================================================================
# LOCAL DEVELOPMENT OVERRIDES
# ============================================================================

# Personal development files
.personal/
.local/
local_*
personal_*

# Development databases
dev.db
local.sqlite

# Local scripts
local_*.sh
personal_*.py

# ============================================================================
# MODERNIZATION ARTIFACTS (CLEANUP COMPLETE)
# ============================================================================

# These patterns catch any remaining modernization artifacts
MODERNIZATION_*.md
PHASE_*.md
*_MIGRATION_*.md
*_COMPLETION_*.md
FINAL_*.md
*_ACHIEVEMENT_*.md
*_VALIDATION_*.md

# Temporary reports (all moved to docs/)
*_REPORT.md
*_SUMMARY.md
*.report.json

# Mission logs (cleanup complete)
MISSION_*.log
ECOSYSTEM_*.log
*_STATUS.log showcase/outputs/
showcase/**/outputs/
*.log
