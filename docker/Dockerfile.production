# BearDog Production Docker Image
# Multi-stage build optimized for production deployment

# Build stage
FROM rust:1.75-slim as builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    libclang-dev \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy dependency files
COPY Cargo.toml Cargo.lock ./
COPY crates/ ./crates/

# Build dependencies (cached layer)
RUN cargo build --workspace --release --locked

# Copy source code
COPY src/ ./src/
COPY tests/ ./tests/
COPY configs/ ./configs/

# Build application
RUN cargo build --workspace --release --locked

# Runtime stage
FROM debian:bookworm-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -r -s /bin/false -m -d /app beardog

# Set working directory
WORKDIR /app

# Copy built binaries
COPY --from=builder /app/target/release/beardog* ./bin/
COPY --from=builder /app/configs/ ./configs/

# Create necessary directories
RUN mkdir -p logs data tmp && \
    chown -R beardog:beardog /app

# Switch to non-root user
USER beardog

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD ./bin/beardog --health-check || exit 1

# Expose ports
EXPOSE 8080 8443 9090

# Environment variables
ENV RUST_LOG=info
ENV BEARDOG_CONFIG_PATH=/app/configs/beardog-config.toml
ENV BEARDOG_DATA_DIR=/app/data
ENV BEARDOG_LOG_DIR=/app/logs

# Default command
CMD ["./bin/beardog", "--config", "/app/configs/beardog-config.toml"] 